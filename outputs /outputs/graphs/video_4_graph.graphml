  <graph edgedefault="directed">
    <node id="concept_1">
      <data key="d0">The Magnetic Field</data>
      <data key="d1">A region around a magnetic substance where magnetic forces can be detected</data>
      <data key="d2">5</data>
    </node>
    <node id="concept_2">
      <data key="d0">The Magnetism</data>
      <data key="d1">A physical phenomenon resulting from the interaction between magnetic fields</data>
      <data key="d2">5</data>
    </node>
    <node id="concept_3">
      <data key="d0">The Circuit</data>
      <data key="d1">A path through which electric current flows</data>
      <data key="d2">4</data>
    </node>
    <node id="concept_4">
      <data key="d0">The Compass</data>
      <data key="d1">A device used to detect and measure magnetic fields</data>
      <data key="d2">4</data>
    </node>
    <node id="concept_5">
      <data key="d0">The Current</data>
      <data key="d1">The flow of electric charge</data>
      <data key="d2">5</data>
    </node>
    <node id="concept_6">
      <data key="d0">A Wire</data>
      <data key="d1">A conductor through which electric current flows</data>
      <data key="d2">4</data>
    </node>
    <node id="concept_7">
      <data key="d0">The Direction</data>
      <data key="d1">The orientation of a magnetic field or electric current</data>
      <data key="d2">4</data>
    </node>
    <node id="concept_8">
      <data key="d0">The Needle</data>
      <data key="d1">A component of a compass that indicates the direction of a magnetic field</data>
      <data key="d2">4</data>
    </node>
    <node id="concept_9">
      <data key="d0">Electromagnetism</data>
      <data key="d1">A fundamental physical phenomenon that describes the interaction between electric and magnetic fields</data>
      <data key="d2">5</data>
    </node>
    <node id="concept_10">
      <data key="d0">Oersted's Experiment</data>
      <data key="d1">A historical experiment that demonstrated the relationship between electric current and magnetic fields</data>
      <data key="d2">5</data>
    </node>
    <node id="concept_11">
      <data key="d0">Magnetic Substance</data>
      <data key="d1">A material that is capable of being magnetized or exhibiting magnetic properties</data>
      <data key="d2">4</data>
    </node>
    <node id="concept_12">
      <data key="d0">Ferromagnetic Substance</data>
      <data key="d1">A type of magnetic substance that is strongly attracted to magnets</data>
      <data key="d2">4</data>
    </node>
